<!DOCTYPE html>
<html lang="RU">
    <head>
        <title>игры вархаммер40к</title>
        <link rel="stylesheet" href="style.css">
    </head>

    <body>
        <div class="header-container">
            <div class="header">
                <img id="logo" src="res/40k_Logo_Colour_1.webp" alt="logo">
                <!--<h1>Топ 5 </h1> -->
                <button id="btn-share" type="button" onclick="share()">Поделиться</button>
            </div>
        </div>

        <h1 id="title">Империя человечества</h1>
        <div class="grid-container">
            <div class="card-view">
                <img src="res/adeptus/40K_LP_-_Imperium_-_Adeptus_Mechanicus.webp" alt="mechanicus">
                <div class="card-view-textbox">
                    <h3>Adeptus Mechanicus</h3>
                    <h4>Fraction</h4>
                    <p>Imperium technology factory</p>
                </div>
            </div>
            <div class="card-view">
                                <img src="res/adeptus/HP-241008-824x1256-ImperialAgentsCodex.webp" alt="HP-241008-824x1256-ImperialAgentsCodex">
                <div class="card-view-textbox">
                    <h3>Imperium Agents</h3>
                    <h4>Fraction</h4>
                    <p>Agents of imperial codex</p>
                </div>
            </div>
            <div class="card-view">
                                <img src="res/adeptus/LP-240413-CODEXCARD-Custodes__1_.webp" alt="cust">
                <div class="card-view-textbox">
                    <h3>Adeptus Custodes</h3>
                    <h4>Fraction</h4>
                    <p>The Emperor bodyguards</p>
                </div>
            </div>
            <div class="card-view">
                                <img src="res/adeptus/LP40K-240608-Square-Sororitas.webp" alt="idk">
                <div class="card-view-textbox">
                    <h3>Adeptus Mechanicus</h3>
                    <h4>Fraction</h4>
                    <p>Imperium technology factory</p>
                </div>
            </div>
            <div class="card-view">
                                <img src="res/adeptus/LP40K-TOUT-060925-ImperialKnightsCodex.webp" alt="Agents2">
                <div class="card-view-textbox">
                    <h3>Agents 2</h3>
                    <h4>Fraction</h4>
                    <p>Imperium technology factory</p>
                </div>
            </div>
        </div>
        <div class="footer">
            <p>Ермолаев Константин Дмитриевич</p>
            <img class="social-media-icon" src="res/telegram-icon-free-png-3410861026.png" alt="tg">
            <img class="social-media-icon" src="res/youtube-icon-for-web-design-free-png-1319777305.png" alt="yt">

        </div>


    </body>
</html>